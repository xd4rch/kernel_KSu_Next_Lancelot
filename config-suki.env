# Base Kernel Configuration
KERNEL_SOURCE=https://github.com/LineageOS/android_kernel_xiaomi_mt6768
KERNEL_SOURCE_BRANCH=lineage-20
KERNEL_ARCH=arm64
KERNEL_IMAGE_NAME=Image.gz

# SukiSU Ultra (Source-based SUSFS)
ENABLE_KERNELSU=true
KERNELSU_SETUP_SOURCE=https://raw.githubusercontent.com/SukiSU-Ultra/SukiSU-ultra/main/kernel/setup.sh
KERNELSU_TAG=susfs-main
ADD_KPROBES_CONFIG=false
KSU_HOOKS_PATCH=false
ENABLE_KSU_SUSFS=true

# KPM Binary Patch Kapatıldı (Kaynak koddan gömüldüğü için binary yamaya gerek yoktur)
KPM_SUPPORT=false

# Compiler (Proton Clang - 4.14 MTK için altın standart)
USE_CLANG=true
CLANG_SOURCE=https://github.com/kdrag0n/proton-clang/archive/refs/heads/master.tar.gz
USE_GCC=false
USE_GCC_64=false
USE_GCC_32=false

# AnyKernel3 Ayarları
USE_ANYKERNEL3=true
ANYKERNEL3_SOURCE=https://github.com/osm0sis/AnyKernel3.git
ANYKERNEL3_BRANCH=master
